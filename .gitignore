# Apps now live in this repo, so the old "ignore /apps*/* except these 12"
# allowlist is gone: every app under /apps is tracked. What is ignored instead is
# each app's build output. The bundled-app list itself did not disappear, it moved
# to core_bundled_apps in the Makefile, where it is used rather than implied.
#
# These patterns are deliberately anchored one level under the app directory:
# .gitignore's * does not cross /, so apps/*/vendor/ ignores an app's composer
# vendor dir without touching the js/vendor/ trees that notes, files_pdfviewer
# and files_texteditor legitimately track and ship.
/apps/*/vendor/
/apps/*/node_modules/
/apps/*/build/
/apps/*/vendor-bin/*/vendor/
/apps/*/.phpunit.result.cache
/apps/*/.scannerwork/
/apps/files_external/3rdparty/irodsphp/PHPUnitTest
/apps/files_external/3rdparty/irodsphp/web
/apps/files_external/3rdparty/irodsphp/prods/test
/apps/files_external/3rdparty/irodsphp/prods/tutorials
/apps/files_external/3rdparty/irodsphp/prods/test*
/apps/files_external/tests/config.*.php

/lib/composer
/apps/files_external/3rdparty/*

# ignore themes except the example and the README
/themes/*
!/themes/example
!/themes/README

